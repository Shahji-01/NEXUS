# ============================================================================
# NEXUS — environment configuration
# Copy to `.env` and fill in values:  cp .env.example .env
# ============================================================================

# ---- Required (API) --------------------------------------------------------

# HMAC-SHA256 signing key for auth tokens. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Local development (pnpm dev, NO Docker) -------------------------------
# The API loads these from this .env via --env-file. For Docker, compose
# builds DATABASE_URL itself from the POSTGRES_* vars below (ignore these two).
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexus

# ---- Optional --------------------------------------------------------------

# Enables the AI Copilot (Google Gemini). Leave blank to disable.
GEMINI_API_KEY=

# ---- Docker Compose only ---------------------------------------------------
# Postgres credentials for the bundled `db` service (compose derives the
# container DATABASE_URL from these — it points at the `db` service, not localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus

# Host port to expose the app on (container always listens on 8080).
APP_PORT=8080
